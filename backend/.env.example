# 1º Provedor (Mais rápido para voz: ~0.3s - 0.6s) — Grátis em https://console.groq.com/keys
GROQ_API_KEY=
BALC_GROQ_MODEL=llama-3.3-70b-versatile

# 2º Provedor Opcional (Ultra rápido e gratuito) — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
BALC_CEREBRAS_MODEL=llama-3.3-70b

# 3º Provedor Opcional (Modelos :free para ampliar limite) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
BALC_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4º Provedor / Fallback automático (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui
BALC_GEMINI_MODEL=gemini-3.5-flash-lite

# Porta do backend BALC (separada de qualquer site cliente)
PORT=8001

# Segurança: origens permitidas no CORS (separadas por vírgula)
BALC_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Limites de requisições por minuto por IP (opcional)
BALC_RATE_LIMIT_CHAT=40
BALC_RATE_LIMIT_TTS=80
# Defina como true apenas quando rodar atrás de proxy reverso confiável (Nginx, Cloud Run, Cloudflare)
BALC_TRUST_PROXY=false
